# Copier en .env.local et compléter. Ne jamais committer les vraies valeurs.
# En production, les valeurs viennent de .github/workflows/deploy.yml (build-args + env_vars).

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SSO_URL=http://localhost:3000
NEXT_PUBLIC_SSO_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api

# Application OAuth2 déclarée dans l'admin du SSO (algorithme RS256, PKCE)
SSO_CLIENT_ID=
# Uniquement si l'application est "Confidential"
SSO_CLIENT_SECRET=
# Doit figurer EXACTEMENT dans les "Redirect uris" de l'application
REDIRECT_URI=http://localhost:3001/api/auth/callback
